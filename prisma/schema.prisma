// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                Int        @id @default(autoincrement())
  username          String     @unique
  passwordHash      String
  refreshToken      String?
  calendarToken     String?    @unique
  profileImage      String?
  name              String
  email             String     @unique
  roles             UserRole[]
  cookingpointsBase Int        @default(0)
  isActive          Boolean    @default(true)

  cookingGroup   CookingGroup?  @relation(fields: [cookingGroupId], references: [id])
  cookingGroupId Int?
  Availability   Availability[]
  AssignedDay    AssignedDay[]

  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
}

model UserRole {
  userId Int
  role   Role
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model CookingGroup {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  User         User[]
  assignedDays AssignedDay[]
  color        String        @default("aaaaaa")
  createdAt    DateTime      @default(now())
  modifiedAt   DateTime      @updatedAt
}

model Availability {
  id           Int              @id @default(autoincrement())
  day          Int // Dag van de maand (1-31)
  availability AvailabilityType
  createdAt    DateTime         @default(now())
  modifiedAt   DateTime         @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  userId        Int
  monthRoster   MonthRoster @relation(fields: [monthRosterId], references: [id])
  monthRosterId Int
}

model BlockedDay {
  id  Int @id @default(autoincrement())
  day Int // 1 - 31

  monthRoster   MonthRoster @relation(fields: [monthRosterId], references: [id])
  monthRosterId Int
}

model AssignedDay {
  id             Int @id @default(autoincrement())
  day            Int // 1 - 31
  cookingGroupId Int

  user         User         @relation(fields: [userId], references: [id])
  userId       Int
  cookingGroup CookingGroup @relation(fields: [cookingGroupId], references: [id], onDelete: Restrict)

  monthRoster   MonthRoster @relation(fields: [monthRosterId], references: [id])
  monthRosterId Int
}

model MonthRoster {
  id     Int         @id @default(autoincrement())
  year   Int
  month  Int // Maand (1-12)
  status MonthStatus @default(CANFILLIN)

  availabilities Availability[]
  blockedDates   BlockedDay[]
  assignedDays   AssignedDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month], name: "year_month")
}

enum Role {
  USER
  COOKING
  ADMIN
}

// Maybe not use AVAILABLE since no data means available
enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
  POSITIVE
  NEGATIVE
}

enum MonthStatus {
  CANFILLIN
  NOFILLIN
  ASSIGNED
}
