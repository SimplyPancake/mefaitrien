// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int     @id @default(autoincrement())
  username      String  @unique
  passwordHash  String
  refreshToken  String?
  name          String
  email         String  @unique
  role          Role    @default(USER)
  cookingpoints Int     @default(0)

  cookingGroup   CookingGroup?  @relation(fields: [cookingGroupId], references: [id])
  cookingGroupId Int?
  Availability   Availability[]
  AssignedDay    AssignedDay[]

  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
}

model CookingGroup {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  User       User[]
  color      String   @default("aaaaaa")
  createdAt  DateTime @default(now())
  modifiedAt DateTime @updatedAt
}

model Availability {
  id           Int              @id @default(autoincrement())
  day          Int // Dag van de maand (1-31)
  availability AvailabilityType
  createdAt    DateTime         @default(now())
  modifiedAt   DateTime         @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  userId        Int
  monthRoster   MonthRoster @relation(fields: [monthRosterId], references: [id])
  monthRosterId Int
}

model BlockedDay {
  id  Int @id @default(autoincrement())
  day Int // 1 - 31

  monthRoster   MonthRoster @relation(fields: [monthRosterId], references: [id])
  monthRosterId Int
}

model AssignedDay {
  id  Int @id @default(autoincrement())
  day Int // 1 - 31

  user   User @relation(fields: [userId], references: [id])
  userId Int

  monthRoster   MonthRoster @relation(fields: [monthRosterId], references: [id])
  monthRosterId Int
}

model MonthRoster {
  id     Int         @id @default(autoincrement())
  year   Int
  month  Int // Maand (1-12)
  status MonthStatus @default(CANFILLIN)

  availabilities Availability[]
  blockedDates   BlockedDay[]
  AssignedDay    AssignedDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month], name: "year_month")
}

enum Role {
  USER
  COOKING
  ADMIN
}

// Maybe not use AVAILABLE since no data means available
enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
  POSITIVE
  NEGATIVE
}

enum MonthStatus {
  CANFILLIN
  NOFILLIN
  ASSIGNED
}
