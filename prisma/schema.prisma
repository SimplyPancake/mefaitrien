// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int        @id @default(autoincrement())
  username      String     @unique
  passwordHash  String
  refreshToken  String?
  calendarToken String?    @unique
  profileImage  String?
  name          String
  email         String     @unique
  roles         UserRole[]
  isActive      Boolean    @default(true)

  cookingpointsBase Int @default(0)
  washingpointsBase Int @default(0)

  cookingGroup   CookingGroup?  @relation(fields: [cookingGroupId], references: [id])
  cookingGroupId Int?
  Availability   Availability[]
  AssignedDay    AssignedDay[]

  createdAt                         DateTime                     @default(now())
  modifiedAt                        DateTime                     @updatedAt
  washingRegistrationsAsWashUserOne WashingRegistration[]        @relation("washingUserOne")
  washingRegistrationsAsWashUserTwo WashingRegistration[]        @relation("washingUserTwo")
  washingRegistrationEatUsers       WashingRegistrationEatUser[]
  washingPenalties                  WashingPenalty[]

  absences Absence[]
}

model WashingPenalty {
  id     Int    @id @default(autoincrement())
  amount Int    @default(1)
  reason String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WashingRegistration {
  id Int @id @default(autoincrement())

  cookingGroup   CookingGroup @relation(fields: [cookingGroupId], references: [id])
  cookingGroupId Int

  assignedDayId Int         @unique
  assignedDay   AssignedDay @relation(fields: [assignedDayId], references: [id])

  washUserOneId Int
  washUserOne   User @relation("washingUserOne", fields: [washUserOneId], references: [id], onDelete: Cascade)

  washUserTwoId Int
  washUserTwo   User @relation("washingUserTwo", fields: [washUserTwoId], references: [id], onDelete: Cascade)

  washingRegistrationEatUsers WashingRegistrationEatUser[]
}

model WashingRegistrationEatUser {
  amountEat Int @default(1)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  washingRegistrationId Int
  washingRegistration   WashingRegistration @relation(fields: [washingRegistrationId], references: [id])

  @@id([userId, washingRegistrationId])
}

model UserRole {
  id Int @id @default(autoincrement())
  userId Int
  role   Role
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model CookingGroup {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  User                 User[]
  assignedDays         AssignedDay[]
  color                String                @default("aaaaaa")
  createdAt            DateTime              @default(now())
  modifiedAt           DateTime              @updatedAt
  washingRegistrations WashingRegistration[]
}

model Availability {
  id           Int              @id @default(autoincrement())
  day          Int // Dag van de maand (1-31)
  availability AvailabilityType
  createdAt    DateTime         @default(now())
  modifiedAt   DateTime         @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  userId        Int
  monthRoster   MonthRoster @relation(fields: [monthRosterId], references: [id])
  monthRosterId Int
}

model BlockedDay {
  id  Int @id @default(autoincrement())
  day Int // 1 - 31

  monthRoster   MonthRoster @relation(fields: [monthRosterId], references: [id])
  monthRosterId Int
}

model AssignedDay {
  id             Int @id @default(autoincrement())
  day            Int // 1 - 31
  cookingGroupId Int

  user         User         @relation(fields: [userId], references: [id])
  userId       Int
  cookingGroup CookingGroup @relation(fields: [cookingGroupId], references: [id], onDelete: Restrict)

  monthRoster         MonthRoster          @relation(fields: [monthRosterId], references: [id])
  monthRosterId       Int
  washingRegistration WashingRegistration?
}

model MonthRoster {
  id     Int         @id @default(autoincrement())
  year   Int
  month  Int // Maand (1-12)
  status MonthStatus @default(CANFILLIN)

  availabilities Availability[]
  blockedDates   BlockedDay[]
  assignedDays   AssignedDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month], name: "year_month")
}

model Absence {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  start DateTime
  end   DateTime?
}

enum Role {
  USER
  COOKING
  ADMIN
  FEUT
  SOUND
}

// Maybe not use AVAILABLE since no data means available
enum AvailabilityType {
  AVAILABLE
  UNAVAILABLE
  POSITIVE
  NEGATIVE
}

enum MonthStatus {
  CANFILLIN
  NOFILLIN
  ASSIGNED
}
